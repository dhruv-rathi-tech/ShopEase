# ============================================================
# ShopEase — Environment Variables Template
# Copy this file to .env (or backend/.env) and fill in your values
# ============================================================

# Server Port (Railway sets PORT automatically)
PORT=3000

# Database Configuration (Option A: Individual Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce
DB_SSL=false

# Database Configuration (Option B: Connection URI - Used by Railway, TiDB, Aiven)
# DATABASE_URL=mysql://root:password@containers-us-west-xx.railway.app:3306/railway
# MYSQL_URL=mysql://root:password@containers-us-west-xx.railway.app:3306/railway

# JWT Secret Key (Any long random string)
JWT_SECRET=your_jwt_secret_key_change_in_production_12345

# Razorpay Test / Live Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
